<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 (API 30) and lower.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   The DataStore holds the saved login credentials, so it must never leave the device.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/" />
</full-backup-content>
